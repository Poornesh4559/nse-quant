# ---- Database (storage/docker-compose.yml) — overrides compose defaults ----
# Usage: cp .env.example .env && cd storage && docker compose --env-file ../.env up -d
POSTGRES_USER=nse
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=nse_quant

# ---- Fyers API (Phase 1 collector) ----
# Get from https://myapi.fyers.in/dashboard
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
# 1-day access token — refresh daily (script in collector/)
FYERS_ACCESS_TOKEN=

# ---- Fallback data ----
# Yahoo Finance needs no key. Optional Alpha Vantage:
# ALPHA_VANTAGE_KEY=

# ---- News sentiment ----
# VADER needs nothing. Optional LLM key for article summaries:
# GEMINI_API_KEY=
