# ---- Database (storage/docker-compose.yml) — overrides compose defaults ----
# Usage: cp .env.example .env && cd storage && docker compose --env-file ../.env up -d
POSTGRES_USER=nse
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=nse_quant

# ---- Fyers API (Phase 1 collector) ----
# App creds from https://myapi.fyers.in/dashboard
FYERS_APP_ID=
FYERS_APP_TYPE=100
FYERS_APP_SECRET=
# redirect_uri registered with the app (must match exactly)
FYERS_REDIRECT_URI=https://fyers.in/
# Fyers account creds for headless token refresh (vagator v2 flow)
# FYERS_ID: your Fyers id (alphanumeric, from your account)
FYERS_ID=
# TOTP base32 secret (see Fyers app) — enables TOTP generation for login
FYERS_TOTP_KEY=
# account login PIN
FYERS_PIN=
# Optional: manually pasted access token (fallback if headless login fails).
# When empty, collector runs headless login to generate one automatically.
FYERS_ACCESS_TOKEN=

# ---- Fallback data ----
# Yahoo Finance needs no key. Optional Alpha Vantage:
# ALPHA_VANTAGE_KEY=

# ---- News sentiment ----
# VADER needs nothing. Optional LLM key for article summaries:
# GEMINI_API_KEY=
